# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-here-generate-with-openssl-rand-base64-32
AUTH_SECRET=your-secret-here-generate-with-openssl-rand-base64-32
MOBILE_AUTH_REDIRECT_URI=sift://auth/callback

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Database
POSTGRES_URL=your-vercel-postgres-url

# Asana OAuth
ASANA_CLIENT_ID=your-asana-client-id
ASANA_CLIENT_SECRET=your-asana-client-secret

# Todoist OAuth
TODOIST_CLIENT_ID=your-todoist-client-id
TODOIST_CLIENT_SECRET=your-todoist-client-secret

# OpenAI (for smart email classification)
OPENAI_API_KEY=your-openai-api-key

# Email classifier LLM backend.
#   CLASSIFIER_PROVIDER=openai  (default) -> gpt-4o-mini via OPENAI_API_KEY
#   CLASSIFIER_PROVIDER=ollama           -> local model on the Mac via ollama
# Flip back to openai any time by changing this one line (or removing it).
CLASSIFIER_PROVIDER=openai
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
